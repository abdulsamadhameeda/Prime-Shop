@using PrimeShop.Application.features.Category.Dtos
@model List<PrimeShop.Application.features.Product.Dtos.ProductDto>
@{
    var categories = ViewBag.Categories as List<CategoryDto>;

}


<!-- Start Banner Area -->
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Shop</h1>

            </div>
        </div>
    </div>
</section>
<!-- End Banner Area -->
<div class="container mt-3">
    <div class="row">
        <div class="col-xl-3 col-lg-4 col-md-5 ">
            <div class="sidebar-categories">
                <div class="head rounded-top">Browse Categories</div>
                <ul class="main-categories">
                    <li class="main-nav-list">
                        <a onclick="filters(null, null, null)" style="cursor:pointer;">All Products</a>
                    </li>

                    @foreach (var category in categories)
                    {
                        <li class="main-nav-list">
                            <a onclick="filters('@category.Id', null, null)" style="cursor:pointer;">
                                @category.Name
                            </a>
                        </li>
                    }

                </ul>

            </div>
            <div class="sidebar-filter mt-50">
                <div class="top-filter-head rounded-top">Product Filters</div>
                <div class="common-filter">
                    <div class="head pl-0 ">Price</div>
                    <form id="price-filter-form">
                        <input type="hidden" id="selected-category-id" value="" />

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <input type="number" name="minPrice" class="form-control" placeholder="Min" min="0" />
                            <span>to</span>
                            <input type="number" name="maxPrice" class="form-control" placeholder="Max" min="0" />
                        </div>
                        <button type="submit"
                                class="primary-btn w-50 mx-auto d-block "
                                style="width: 100px; height: 40px; line-height: 40px; padding: 0 15px;  border-radius: 0; border: none;">
                            Apply
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-9 col-lg-8 col-md-7">
            <!-- Start Filter Bar -->
            <div class="filter-bar d-flex flex-wrap align-items-center rounded-top">
                <div class="sorting ">
                    <select id="sort-products" >
                        <option value="default">Default sorting</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="name-asc">Name: A to Z</option>
                        <option value="name-desc">Name: Z to A</option>
                    </select>
                </div>

                <div class="sorting mr-auto">
                    <select id="products-per-page">
                        <option value="10">Show 10</option>
                        <option value="20">Show 20</option>
                        <option value="30">Show 30</option>
                    </select>
                </div>

                <div class="pagination" id="products-pagination">
                </div>
            </div>
            <!-- End Filter Bar -->
            <!-- Start Best Seller -->
            <section class="lattest-product-area pb-40 category-list">
                <div class="row" id="products-container">




                </div>
            </section>
            <!-- End Best Seller -->

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var jwtToken = '@Context.Request.Cookies["jwt"]';
    </script>
    <script src="~/js/product/shopCategory.js" asp-append-version="true"></script>

}
<style>
    .product-image-wrapper {
        position: relative;
        overflow: hidden;
    }

    .out-of-stock-banner {
        position: absolute;
        top: 50%;
        left: -10%;
        width: 120%;
        padding: 10px 0;
        background: rgba(220, 53, 69, 0.9);
        color: #fff;
        text-align: center;
        font-weight: bold;
        text-transform: uppercase;
        transform: translateY(-50%) rotate(-10deg);
        pointer-events: none;
    }
</style>