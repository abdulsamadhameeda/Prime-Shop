@using PrimeShop.Application.features.Category.Dtos
@model List<PrimeShop.Application.features.Product.Dtos.ProductDto>
@{
    var categories = ViewBag.Categories as List<CategoryDto>;

}


<!-- Start Banner Area -->
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Shop Category page</h1>

            </div>
        </div>
    </div>
</section>
<!-- End Banner Area -->
<div class="container">
    <div class="row">
        <div class="col-xl-3 col-lg-4 col-md-5">
            <div class="sidebar-categories">
                <div class="head">Browse Categories</div>
                <ul class="main-categories">
                    <li class="main-nav-list">
                        <a asp-controller="Product" asp-action="ShopCategory">All Products</a>
                    </li>

                    @foreach (var category in categories)
                    {
                        <li class="main-nav-list">
                            <a asp-controller="Product" asp-action="ShopCategory" asp-route-categoryId="@category.Id">
                                @category.Name
                            </a>
                        </li>
                    }

                </ul>
            </div>
            <div class="sidebar-filter mt-50">
                <div class="top-filter-head">Product Filters</div>
                <div class="common-filter">
                    <div class="head">Price</div>
                    <form method="get" asp-action="ShopCategory">
                        <input type="hidden" name="categoryId" value="@Context.Request.Query["categoryId"]" />
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <input type="number" name="minPrice" class="form-control" placeholder="Min" value="@ViewBag.MinPrice" min="0" />
                            <span>to</span>
                            <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="@ViewBag.MaxPrice" min="0" />
                        </div>
                        <button type="submit" class="primary-btn btn btn-sm w-50 mx-auto d-block">Apply</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-9 col-lg-8 col-md-7">
            <!-- Start Filter Bar -->
            <div class="filter-bar d-flex flex-wrap align-items-center">
                <div class="sorting">
                    <select>
                        <option value="1">Default sorting</option>
                        <option value="1">Default sorting</option>
                        <option value="1">Default sorting</option>
                    </select>
                </div>
                <div class="sorting mr-auto">
                    <select>
                        <option value="1">Show 12</option>
                        <option value="1">Show 12</option>
                        <option value="1">Show 12</option>
                    </select>
                </div>
                <div class="pagination">
                    <a href="#" class="prev-arrow"><i class="fa fa-long-arrow-left" aria-hidden="true"></i></a>
                    <a href="#" class="active">1</a>
                    <a href="#">2</a>
                    <a href="#">3</a>
                    <a href="#" class="dot-dot"><i class="fa fa-ellipsis-h" aria-hidden="true"></i></a>
                    <a href="#">6</a>
                    <a href="#" class="next-arrow"><i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
            <!-- End Filter Bar -->
            <!-- Start Best Seller -->
            <section class="lattest-product-area pb-40 category-list">
                <div class="row" id="products-container">
                    @foreach (var product in Model)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="single-product">
                                <img class="img-fluid" src="/@product.ImageUrl" alt="@product.Name">
                                <div class="product-details">
                                    <h6>@product.Name</h6>
                                    <div class="price">
                                        <h6>$@product.Price</h6>
                                    </div>
                                    <div class="prd-bottom">
                                        <a onclick="addToBasket('@product.Id')" class="social-info">
                                            <span class="ti-bag"></span>
                                            <p class="hover-text">add to bag</p>
                                        </a>
                                        <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="social-info">
                                            <span class="lnr lnr-move"></span>
                                            <p class="hover-text">view more</p>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
            <!-- End Best Seller -->

        </div>
    </div>
</div>

@section Scripts {
    <script>
               function addToBasket(productId) {
                    var basket = JSON.parse(localStorage.getItem('basket')) || [];
                    var token = '@Context.Session.GetString("Token")';

                    if (token) {
                        $.ajax({
                            url: '/Basket/AddItemToBasket',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify([{ productId: productId, quantity: 1 }]),
                            success: function() {
        Swal.fire({
               toast: true,
               position: 'bottom-end',
               icon: 'success',
               title: 'Added to basket!',
               showConfirmButton: false,
               timer: 2000,
               timerProgressBar: true,
               background: '#FFA500',
               color: '#fff',
               iconColor: '#fff',
               showClass: {
               popup: 'swal2-noanimation'
               },
               hideClass: {
               popup: ''
               }
               });
                                 },
                            error: function() {
                Swal.fire({
                                   toast: true,
                                   position: 'bottom-right',
                                   icon: 'error',
                                   title: 'Error adding to basket!',
                                   showConfirmButton: false,
                                   timer: 2000,
                                   background: '#ff4444',
                                   color: '#fff',
                                   iconColor: '#fff'
                               });                    }
                        });
                    } else {
                        var existing = basket.find(x => x.productId === productId);

                        if (existing) {
                            existing.quantity += 1;
                        } else {
                            basket.push({ productId: productId, quantity: 1 });
                        }

                        localStorage.setItem('basket', JSON.stringify(basket));
                      Swal.fire({
            toast: true,
            position: 'bottom-end',
            icon: 'success',
            title: 'Added to basket!',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
            background: '#FFA500',
            color: '#fff',
            iconColor: '#fff',
            showClass: {
                popup: 'swal2-noanimation'
            },
            hideClass: {
                popup: ''
            }
        });
                                }
                }
    </script>
}
