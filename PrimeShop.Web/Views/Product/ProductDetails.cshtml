@using PrimeShop.Application.features.Product.Dtos
@model ProductDto



<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Product Details Page</h1>
                
            </div>
        </div>
    </div>
</section>

<div class="product_image_area">
    <div class="container">
        <div class="row s_product_inner">
            <div class="col-lg-6">
                
                <img class="img-fluid  w-100"
                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/category/default-product.jpg" : "/" + Model.ImageUrl.TrimStart('/'))"
                         alt="@Model.Name">
            </div>
            <div class="col-lg-5 offset-lg-1">
                <div class="s_product_text">
                    <h3>@Model.Name</h3>
                    <h2>@Model.Price.ToString("C")</h2>
                    <ul class="list">
                        <li><a class="active" href="#"><span>Category</span> : @Model.CategoryName</a></li>
                        <li>
                            <a href="#">
                                <span>Availability</span> :
                                @(Model.StockQuantity > 0 ? "In Stock" : "Out of Stock")
                            </a>
                        </li>
                    </ul>
                    <p>@Model.Description</p>

                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />

                        <div class="product_count">
                            <label for="qty">Quantity:</label>
                            <input type="number" name="quantity" id="sst" min="1"
                                   max="@Model.StockQuantity" value="1" class="input-text qty" />
                            <button onclick="var result = document.getElementById('sst'); if(parseInt(result.value) < @Model.StockQuantity) result.value++; return false;"
                                    class="increase items-count" type="button">
                                <i class="lnr lnr-chevron-up"></i>
                            </button>
                            <button onclick="var result = document.getElementById('sst'); if(parseInt(result.value) > 1) result.value--; return false;"
                                    class="reduced items-count" type="button">  
                                <i class="lnr lnr-chevron-down"></i>
                            </button>
                        </div>

                        <div class="card_area d-flex align-items-center">
                            <a class="primary-btn text-white" onclick="addToBasket('@Model.Id')" @(Model.StockQuantity == 0 ? "disabled" : "")>
                                Add to Cart
                            </a>
                            
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="product_description_area">
    <div class="container">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab">Description</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab">Specification</a>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="home" role="tabpanel">
                <p>@Model.Description</p>
            </div>
            <div class="tab-pane fade" id="profile" role="tabpanel">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                            <tr><td><h5>Stock</h5></td><td><h5>@Model.StockQuantity</h5></td></tr>
                            <tr><td><h5>Price</h5></td><td><h5>@Model.Price.ToString("C")</h5></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
               function addToBasket(productId) {
                    var basket = JSON.parse(localStorage.getItem('basket')) || [];
                    var quantity = document.getElementById('sst').value;
                    var token = '@Context.Session.GetString("Token")';
                    if (token) {
                        $.ajax({
                            url: '/Basket/AddItemToBasket',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify([{ productId: productId, quantity: quantity }]),
                            success: function() {
        Swal.fire({
               toast: true,
               position: 'bottom-end',
               icon: 'success',
               title: 'Added to basket!',
               showConfirmButton: false,
               timer: 2000,
               timerProgressBar: true,
               background: '#FFA500',
               color: '#fff',
               iconColor: '#fff',
               showClass: {
               popup: 'swal2-noanimation'
               },
               hideClass: {
               popup: ''
               }
               });
                                 },
                            error: function() {
                Swal.fire({
                                   toast: true,
                                   position: 'bottom-right',
                                   icon: 'error',
                                   title: 'Error adding to basket!',
                                   showConfirmButton: false,
                                   timer: 2000,
                                   background: '#ff4444',
                                   color: '#fff',
                                   iconColor: '#fff'
                               });                    }
                        });
                    } else {
                        var existing = basket.find(x => x.productId === productId);

                        if (existing) {
                            existing.quantity += 1;
                        } else {
                            basket.push({ productId: productId, quantity: quantity  });
                        }

                        localStorage.setItem('basket', JSON.stringify(basket));
                      Swal.fire({
            toast: true,
            position: 'bottom-end',
            icon: 'success',
            title: 'Added to basket!',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
            background: '#FFA500',
            color: '#fff',
            iconColor: '#fff',
            showClass: {
                popup: 'swal2-noanimation'
            },
            hideClass: {
                popup: ''
            }
        });
                                }
                }
    </script>
}
