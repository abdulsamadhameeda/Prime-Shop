@using PrimeShop.Application.features.Product.Dtos
@model ProductDto



<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Product Details</h1>

            </div>
        </div>
    </div>
</section>

<div class="product_image_area">
    <div class="container">
        <div class="row s_product_inner">
            <div class="col-lg-6">

				<div class="product-image-wrapper">
					<img class="img-fluid"
						 src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "/img/product/p1.jpg")"
						 style="background-color: #f8f9fa; object-fit: contain; width: 100%; height: auto;" />

					@if (Model.StockQuantity <= 0)
					{
						<span class="out-of-stock-banner">Out of Stock</span>
					}
				</div>
			</div>
            <div class="col-lg-5 offset-lg-1">
                <div class="s_product_text">
                    <h3>@Model.Name</h3>
                    <h2>@Model.Price.ToString("C")</h2>
                    <ul class="list">
                        <li><span class="active"><span>Category</span> : @Model.CategoryName</span></li>
                        <li>
                            <span>
                                <span>Availability</span> :
                                <span class="@(Model.StockQuantity > 0 ? "text-success" : "text-danger") fw-bold">
                                    @(Model.StockQuantity > 0 ? "In Stock" : "Out of Stock")
                                </span>
                            </span>
                        </li>
                    </ul>
                    <p>@Model.Description</p>

                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="product_count">
                        <label for="qty">Quantity:</label>
                        <input type="number" name="quantity" id="sst" min="1"
                               max="@Model.StockQuantity" value="1" class="input-text qty" />
                        <button onclick="var result = document.getElementById('sst'); if(parseInt(result.value) < @Model.StockQuantity) result.value++; return false;"
                                class="increase items-count" type="button">
                            <i class="lnr lnr-chevron-up"></i>
                        </button>
                        <button onclick="var result = document.getElementById('sst'); if(parseInt(result.value) > 1) result.value--; return false;"
                                class="reduced items-count" type="button">
                            <i class="lnr lnr-chevron-down"></i>
                        </button>

                    </div>

                    <div class="card_area d-flex align-items-center">
                        <button type="button"
                                class="primary-btn text-white border-0"
                                onclick="addToBasket('@Model.Id', @Model.StockQuantity)"
                            @(Model.StockQuantity <= 0 ? "disabled style=background:#cccccc;cursor:not-allowed;border-color:#cccccc;" : "")>
                            @(Model.StockQuantity > 0 ? "Add to Cart" : "Out of Stock")
                        </button>

                        <a class="icon_btn"
                           href="#"
                           id="wishlist-button"
                           data-product-id="@Model.Id"
                           data-wishlist-id=""
                           onclick="addToWishlist('@Model.Id', this); return false;">
                            <i class="wishlist-icon far fa-heart"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="product_description_area">
    <div class="container">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Description</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile"
                   aria-selected="false">Specification</a>
            </li>

            <li class="nav-item">
                <a class="nav-link " id="review-tab" data-toggle="tab" href="#review" role="tab" aria-controls="review"
                   aria-selected="false">Reviews</a>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="home" role="tabpanel">
                <p>@Model.Description</p>
            </div>
            <div class="tab-pane fade" id="profile" role="tabpanel">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                            <tr><td><h5>Stock</h5></td><td><h5>@Model.StockQuantity</h5></td></tr>
                            <tr><td><h5>Price</h5></td><td><h5>@Model.Price.ToString("C")</h5></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade show " id="review" role="tabpanel" aria-labelledby="review-tab">
                <div class="alert text-center" role="alert" style=" color: #FFA500; background-color: #fff8f0; color: #333;">
                    coming soon
                </div>
               
            </div>

        </div>
    </div>
</section>


@section Scripts {
    <script>
        var jwtToken = '@Context.Request.Cookies["jwt"]';
    </script>
    <script src="~/js/product/productDetails.js" asp-append-version="true"></script>

}
<style>
    .product-image-wrapper {
        position: relative;
        overflow: hidden;
    }

    .out-of-stock-banner {
        position: absolute;
        top: 50%;
        left: -10%;
        width: 120%;
        padding: 10px 0;
        background: rgba(220, 53, 69, 0.9);
        color: #fff;
        text-align: center;
        font-weight: bold;
        text-transform: uppercase;
        transform: translateY(-50%) rotate(-10deg);
        pointer-events: none;
    }
</style>