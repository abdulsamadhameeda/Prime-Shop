@using PrimeShop.Application.features.Product.Dtos
@model List<ProductDto>


<section class="banner-area">
    <div class="container">
        <div class="row fullscreen align-items-center justify-content-start">
            <div class="col-lg-12">
                <div class="active-banner-slider owl-carousel">
                    <!-- single-slide -->
                    @foreach (var product in Model)
                    {
                        <div class="row single-slide align-items-center d-flex">
                            <div class="col-lg-5 col-md-6">
                                <div class="banner-content">
                                    <h1 class="mb-3">@product.Name</h1>
                                    <p>
                                        @product.Description
                                    </p>
                                    <h5>@product.Price.ToString("C")</h5>

                                    <div class="add-bag d-flex align-items-center">
                                        <a @(product.StockQuantity > 0 ? $"onclick=addToBasket('{product.Id}')" : "")
                                            class="add-btn"
                                            style="@(product.StockQuantity <= 0 ? "pointer-events: none; opacity: 0.5; cursor: not-allowed;" : "cursor: pointer;")">
                                            <span class="lnr lnr-cross"></span>
                                        </a>
                                        <span class="add-text text-uppercase">Add to Bag</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="banner-img">
                                    <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id">

                                        <img class="img-fluid rounded-5 w-75 mx-auto d-block" src="@(product.ProductImage != null && product.ProductImage.Length > 0 ? $"data:image/png;base64,{Convert.ToBase64String(product.ProductImage)}" : "/img/product/p1.jpg")" />
                                    </a>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- start features Area -->
<section class="features-area section_gap">
    <div class="container">
        <div class="row features-inner">
            <!-- single features -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon">
                        <img src="img/features/f-icon1.png" alt="">
                    </div>
                    <h6>Free Delivery</h6>
                    <p>Free Shipping on all order</p>
                </div>
            </div>
            <!-- single features -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon">
                        <img src="img/features/f-icon2.png" alt="">
                    </div>
                    <h6>Return Policy</h6>
                    <p>30 days money back guarantee</p>
                </div>
            </div>
            <!-- single features -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon">
                        <img src="img/features/f-icon3.png" alt="">
                    </div>
                    <h6>Support</h6>
                    <p>Customer support available anytime</p>
                </div>
            </div>
            <!-- single features -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="single-features">
                    <div class="f-icon">
                        <img src="img/features/f-icon4.png" alt=""> 
                    </div>
                    <h6>Secure Payment</h6>
                    <p>100% secure payment methods</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end features Area -->

<!-- start product Area -->
<section class="  section_gap">
    <!-- single product slide -->
    <div class="single-product-slider">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">
                    <div class="section-title">
                        <h1>Products</h1>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var product in Model)
                {
                    <!-- single product -->
                    <div class="col-lg-3 col-md-6">
                        <div class="single-product">
                            <img class="img-fluid " src="@(product.ProductImage != null && product.ProductImage.Length > 0 ? $"data:image/png;base64,{Convert.ToBase64String(product.ProductImage)}" : "/img/product/p1.jpg")" style="background-color: #f8f9fa; object-fit: contain; width: 100%; height: 250px;" />
                            <div class="product-details">
                                <h6>
                                    @product.Name
                                </h6>
                                <div class="price">
                                    <h6>@product.Price.ToString("C")</h6>
                                </div>
                                <div class="prd-bottom">
                                    <a @(product.StockQuantity > 0 ? $"onclick=addToBasket('{product.Id}')" : "")
                                        class="social-info"
                                        style="@(product.StockQuantity <= 0 ? "pointer-events: none; opacity: 0.5; cursor: not-allowed;" : "cursor: pointer;")">
                                        <span class="ti-bag"></span>
                                        <p class="hover-text">@(product.StockQuantity > 0 ? "add to bag" : "Out of stock")</p>
                                    </a>
                                    <a href="" class="social-info">
                                        <span class="lnr lnr-heart"></span>
                                        <p class="hover-text">Wishlist</p>
                                    </a>
                                    <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="social-info">
                                        <span class="lnr lnr-eye"></span>
                                        <p class="hover-text">view more</p>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
    <!-- single product slide -->
</section>
<!-- end product Area -->


@section Scripts {

    <script>
        var jwtToken = '@Context.Request.Cookies["jwt"]';
    </script>
    <script src="~/js/home/index.js" asp-append-version="true"></script>


}
