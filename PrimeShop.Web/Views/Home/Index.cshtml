@using PrimeShop.Application.features.Product.Dtos
@model List<ProductDto>


<section class="banner-area">
	<div class="container">
		<div class="row fullscreen align-items-center justify-content-start">
			<div class="col-lg-12">
				<div class="active-banner-slider owl-carousel">
					<!-- single-slide -->
					@foreach (var product in Model)
					{
						<div class="row single-slide align-items-center d-flex">
							<div class="col-lg-5 col-md-6">
								<div class="banner-content">
									<h1 class="mb-3">@product.Name</h1>
									<p>
										@product.Description
									</p>
									<h5>@product.Price.ToString("C")</h5>

									<div class="add-bag d-flex align-items-center">
										<a class="add-btn"  onclick="addToBasket('@product.Id')"><span class="lnr lnr-cross"></span></a>
										<span class="add-text text-uppercase">Add to Bag</span>
									</div>
								</div>
							</div>
							<div class="col-lg-7">
								<div class="banner-img">
								<a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id">

									<img class="img-fluid rounded-5 w-75 mx-auto d-block" src="@(string.IsNullOrEmpty(product.ImageUrl) ? "img/product/p1.jpg" : "/" + product.ImageUrl.TrimStart('/'))" alt="">
								</a>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>

<!-- start features Area -->
<section class="features-area section_gap">
	<div class="container">
		<div class="row features-inner">
			<!-- single features -->
			<div class="col-lg-3 col-md-6 col-sm-6">
				<div class="single-features">
					<div class="f-icon">
						<img src="img/features/f-icon1.png" alt="">
					</div>
					<h6>Free Delivery</h6>
					<p>Free Shipping on all order</p>
				</div>
			</div>
			<!-- single features -->
			<div class="col-lg-3 col-md-6 col-sm-6">
				<div class="single-features">
					<div class="f-icon">
						<img src="img/features/f-icon2.png" alt="">
					</div>
					<h6>Return Policy</h6>
					<p>Free Shipping on all order</p>
				</div>
			</div>
			<!-- single features -->
			<div class="col-lg-3 col-md-6 col-sm-6">
				<div class="single-features">
					<div class="f-icon">
						<img src="img/features/f-icon3.png" alt="">
					</div>
					<h6>24/7 Support</h6>
					<p>Free Shipping on all order</p>
				</div>
			</div>
			<!-- single features -->
			<div class="col-lg-3 col-md-6 col-sm-6">
				<div class="single-features">
					<div class="f-icon">
						<img src="img/features/f-icon4.png" alt="">
					</div>
					<h6>Secure Payment</h6>
					<p>Free Shipping on all order</p>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- end features Area -->
<!-- Start brand Area -->
<section class="brand-area section_gap">
	<div class="container">
		<div class="row">
			<a class="col single-img" href="#">
				<img class="img-fluid d-block mx-auto" src="img/brand/1.png" alt="">
			</a>
			<a class="col single-img" href="#">
				<img class="img-fluid d-block mx-auto" src="img/brand/2.png" alt="">
			</a>
			<a class="col single-img" href="#">
				<img class="img-fluid d-block mx-auto" src="img/brand/3.png" alt="">
			</a>
			<a class="col single-img" href="#">
				<img class="img-fluid d-block mx-auto" src="img/brand/4.png" alt="">
			</a>
			<a class="col single-img" href="#">
				<img class="img-fluid d-block mx-auto" src="img/brand/5.png" alt="">
			</a>
		</div>
	</div>
</section>
<!-- End brand Area -->
<!-- start product Area -->
<section class="  section_gap">
	<!-- single product slide -->
	<div class="single-product-slider">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-6 text-center">
					<div class="section-title">
						<h1>Some Products</h1>
						<p>
							Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et
							dolore
							magna aliqua.
						</p>
					</div>
				</div>
			</div>
			<div class="row">
				@foreach (var product in Model)
				{
					<!-- single product -->
					<div class="col-lg-3 col-md-6">
						<div class="single-product">
							<img class="img-fluid" src="@(string.IsNullOrEmpty(product.ImageUrl) ? "img/product/p1.jpg" : "/" + product.ImageUrl.TrimStart('/'))" alt="">
							<div class="product-details">
								<h6>
									@product.Name
								</h6>
								<div class="price">
									<h6>@product.Price.ToString("C")</h6>
								</div>
								<div class="prd-bottom">
									<a onclick="addToBasket('@product.Id')" class="social-info" >
										<span class="ti-bag"></span>
										<p class="hover-text">add to bag</p>
									</a>
									<a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.Id" class="social-info">
										<span class="lnr lnr-move"></span>
										<p class="hover-text">view more</p>
									</a>
								</div>
							</div>
						</div>
					</div>
				}

			</div>
		</div>
	</div>
	<!-- single product slide -->
</section>
<!-- end product Area -->
@section Scripts {
	<script>
				function addToBasket(productId) {
			var basket = JSON.parse(localStorage.getItem('basket')) || [];
			var token = '@Context.Session.GetString("Token")';

			if (token) {
				$.ajax({
					url: '/Basket/AddItemToBasket',
					type: 'POST',
					contentType: 'application/json',
					data: JSON.stringify([{ productId: productId, quantity: 1 }]),
					success: function() {
		Swal.fire({
					toast: true,
					position: 'bottom-end',
					icon: 'success',
					title: 'Added to basket!',
					showConfirmButton: false,
					timer: 2000,
					timerProgressBar: true,
					background: '#FFA500',
					color: '#fff',
					iconColor: '#fff',
					showClass: {
					popup: 'swal2-noanimation'
					},
					hideClass: {
					popup: ''
					}
					});					},
					error: function() {
						alert('Error adding to basket!');
					}
				});
			} else {
				var existing = basket.find(x => x.productId === productId);

				if (existing) {
					existing.quantity += 1;
				} else {
					basket.push({ productId: productId, quantity: 1 });
				}

				localStorage.setItem('basket', JSON.stringify(basket));
		Swal.fire({
					toast: true,
					position: 'bottom-end',
					icon: 'success',
					title: 'Added to basket!',
					showConfirmButton: false,
					timer: 2000,
					timerProgressBar: true,
					background: '#FFA500',
					color: '#fff',
					iconColor: '#fff',
					showClass: {
					popup: 'swal2-noanimation'
					},
					hideClass: {
					popup: ''
					}
					});			}
		}
	</script>
}
