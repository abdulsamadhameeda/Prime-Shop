<!-- Start Banner Area -->
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Checkout</h1>
               
            </div>
        </div>
    </div>
</section>
<!-- End Banner Area -->
<!--================Checkout Area =================-->
<section class="checkout_area section_gap">
    <div class="container">

      
             <div class="billing_details">
            <div class="row">
                <div class="col-lg-8">
                    <h3>Billing Details</h3>

                    <div class="payment_item">
                        <div class="radion_btn">
                            <input type="radio" id="cash" name="paymentMethod" value="Cash" checked>
                            <label for="cash">Cash on Delivery</label>
                            <div class="check"></div>
                        </div>
                    </div>

                    <div class="payment_item">
                        <div class="radion_btn">
                            <input type="radio" id="visa" name="paymentMethod" value="Visa">
                            <label for="visa">Visa / Credit Card</label>
                            <div class="check"></div>
                        </div>

                        <div id="visa-form" style="display:none;">
                            <div class="mt-3">

                                <input type="text" class="form-control mb-2" placeholder="Card Number" maxlength="16">
                                <div class="d-flex gap-2">
                                    <input type="text" class="form-control" placeholder="MM/YY" maxlength="5">
                                    <input type="text" class="form-control" placeholder="CVV" maxlength="3">
                                </div>
                                <input type="text" class="form-control mt-2" placeholder="Card Holder Name">
                            </div>
                        </div>
                    </div>


                    <form class="row contact_form pt-3" asp-action="Checkout" method="post" novalidate="novalidate">
                        <input type="hidden" id="total-amount" name="totalAmount" />

                        <div class="col-md-6 form-group p_star">
                            <select class="country_select" name="ShippingCityId" required>
                                <option value="">Select City</option>
                                @if (ViewBag.Cities != null)
                                {
                                    foreach (var city in ViewBag.Cities)
                                    {
                                        <option value="@city.Id">@city.Value</option>
                                    }
                                }
                            </select>
                        </div>


                        <div class="col-md-6 form-group p_star">
                            <input type="text" class="form-control" name="shippingStreet" placeholder="Street Address" required>
                        </div>
                     
                        <div class="col-lg-12">
                            <button type="submit" class="primary-btn">Place Order</button>
                        </div>
                    </form>

                    
                </div>

                <div class="col-lg-4">
                    <div class="order_box">
                        <h2>Your Order</h2>
                        <ul class="list" id="order-items">
                            <li><a href="#">Product <span>Total</span></a></li>
                        </ul>
                        <ul class="list list_2">
                            <li><a href="#">Shipping <span>Free</span></a></li>

                            <li><a href="#">Total <span id="order-total"></span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/order/checkout.js" asp-append-version="true"></script>


}