@using PrimeShop.Application.features.Product.Dtos
@using PrimeShop.Application.features.Wishlist.Dtos
@model List<ProductDto>

@{
    var wishlistItems =
        ViewBag.WishlistItems as List<WishlistItemDto>
        ?? new List<WishlistItemDto>();
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Wishlist</h1>
            </div>
        </div>
    </div>
</section>

<section class="cart_area">
    <div class="container">
        <div class="cart_inner">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col" class="col-8">Product</th>
                            <th scope="col" class="col-2">Price</th>
                            <th scope="col" class="col-2"></th>
                        </tr>
                    </thead>

                    <tbody id="wishlist-items">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="p-5">
                                    <div class="alert text-center mb-0"
                                         style="background-color: #fff8f0; color: #333; border: 1px solid #ffe8cc; font-size: 18px;">
                                        Your wishlist is empty
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Model)
                            {
                                var wishlistItem = wishlistItems
                                    .FirstOrDefault(item => item.ProductId == product.Id);

                                if (wishlistItem != null)
                                {
                                    <tr id="wishlist-row-@wishlistItem.Id">
                                        <td>
                                            <div class="media">
                                                <div class="d-flex">
                                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl)
                                                        ? "/img/product/p1.jpg"
                                                        : product.ImageUrl)"
                                                         class="img-fluid"
                                                         style="max-width: 80px;"
                                                         alt="@product.Name">
                                                </div>

                                                <div class="media-body">
                                                    <p>@product.Name</p>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <h5>@product.Price.ToString("C")</h5>
                                        </td>

                                        <td>
                                            <button type="button"
                                                    class="btn btn-danger"
                                                    onclick="confirmWishlistDelete('@wishlistItem.Id')"
                                                    title="Delete">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="3">
                                <div class="checkout_btn_inner d-flex align-items-center justify-content-end">
                                    <a class="gray_btn mr-3"
                                       asp-controller="Product"
                                       asp-action="ShopCategory">
                                        Continue Shopping
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        var jwtToken = '@Context.Request.Cookies["jwt"]';
    </script>

    <script src="~/js/wishlist/ProductWishlist.js"
            asp-append-version="true"></script>
}