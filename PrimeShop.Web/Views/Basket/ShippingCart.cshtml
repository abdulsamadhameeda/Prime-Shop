<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Shopping Cart</h1>
                <nav class="d-flex align-items-center">
                    <a href="index.html">Home<span class="lnr lnr-arrow-right"></span></a>
                    <a href="category.html">Cart</a>
                </nav>
            </div>
        </div>
    </div>
</section>
<section class="cart_area">
    <div class="container">
        <div class="cart_inner">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col" class="col-6">Product</th>
                            <th scope="col" class="col-2">Price</th>
                            <th scope="col" class="col-2">Quantity</th>
                            <th scope="col" class="col-2">Total</th>
                        </tr>
                    </thead>
                    <tbody id="basket-items">
                    </tbody>
                    <tfoot id="checkout-section">
                        <tr>
                            <td></td>
                            <td></td>
                            <td><h5 class="m-0">Subtotal</h5></td>
                            <td><h5 class="m-0" id="basket-total"></h5></td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-right">
                                <div class="checkout_btn_inner d-flex align-items-center justify-content-end">
                                    <a class="gray_btn mr-3" asp-controller="Product" asp-action="ShopCategory">Continue Shopping</a>
                                    <a class="primary-btn" asp-controller="Order" asp-action="Checkout">Proceed to checkout</a>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    $(document).ready(function() {
        var basket = JSON.parse(localStorage.getItem('basket')) || [];
        var token = '@Context.Session.GetString("Token")';

        if (basket.length === 0) {
            if (token) {
                loadCartFromDb();
            }
             else {
                $('#checkout-section').hide();
              $('#basket-items').html('<tr><td colspan="4" class="p-5"><div class="alert text-center" role="alert" style="background-color: #fff8f0; color: #333; border: 1px solid #ffe8cc; font-size: 18px;">Your cart is empty </div></td></tr>');
             }
            return;
        }


        if (token) {
            $.ajax({
                url: '/Basket/AddItemToBasket',  
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(basket),
                success: function() {
                    console.log('Basket synced and saved to DB');

                    localStorage.removeItem('basket');

                    loadCartFromDb();
                    },
                error: function(err) {
                    console.error('Error add basket Item:', err);
                }
            });
        } 
        else 
        {
            loadCartProducts(basket);
        }
    }); 

    function loadCartProducts(currentBasket) {
        var ids = currentBasket.map(x => x.productId);
        if (ids.length === 0) return;

        $.ajax({
            url: '/Basket/GetProductsByIds',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(ids),
            success: function(products) {
                var html = '';
                var total = 0;

                products.forEach(function(product) {
                    var item = currentBasket.find(x => x.productId === product.id);
                    var quantity = item ? item.quantity : 1;
                    var itemTotal = product.price * quantity;
                    total += itemTotal;

                    html += `
                        <tr>
                            <td>
                                <div class="media">
                                    <div class="d-flex">
                                        <img src="/${product.imageUrl}" class="img-fluid" style="max-width: 80px;" alt="" >
                                    </div>
                                    <div class="media-body">
                                        <p>${product.name}</p>
                                    </div>
                                </div>
                            </td>
                            <td><h5>$${product.price}</h5></td>
                            <td>${quantity}</td>
                            <td><h5>$${itemTotal.toFixed(2)}</h5></td>
                        </tr>
                    `;
                });

                $('#basket-items').html(html);
                $('#basket-total').text('$' + total.toFixed(2));
            }
        });
    }

            function loadCartFromDb() {
            $.ajax({
                url: '/Basket/GetBasketItems',
                type: 'GET',
                success: function(items) {
                    if (items.length === 0) {
                        $('#checkout-section').hide();
                        $('#basket-items').html('<tr><td colspan="4" class="p-5"><div class="alert text-center" role="alert" style="background-color: #fff8f0; color: #333; border: 1px solid #ffe8cc; font-size: 18px;">Your cart is empty</div></td></tr>');
                    return
                    };

                    var ids = items.map(x => x.productId);

                    $.ajax({
                        url: '/Basket/GetProductsByIds',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(ids),
                        success: function(products) {
                            var html = '';
                            var total = 0;

                            products.forEach(function(product) {
                                var item = items.find(x => x.productId === product.id);
                                var quantity = item ? item.quantity : 1;
                                var itemTotal = product.price * quantity;
                                total += itemTotal;

                                html += `
                                    <tr>
                                        <td>
                                            <div class="media">
                                                <div class="d-flex">
                                                    <img src="/${product.imageUrl}" class="img-fluid" style="max-width: 80px;" alt="">
                                                </div>
                                                <div class="media-body">
                                                    <p>${product.name}</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td><h5>$${product.price}</h5></td>
                                        <td>${quantity}</td>
                                        <td><h5>$${itemTotal.toFixed(2)}</h5></td>
                                    </tr>
                                `;
                            });

                            $('#basket-items').html(html);
                            $('#basket-total').text('$' + total.toFixed(2));
                        }
                    });
                }
            });
        }



</script>
}