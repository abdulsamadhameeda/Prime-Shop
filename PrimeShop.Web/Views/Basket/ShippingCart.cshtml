<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Shopping Cart</h1>
                <nav class="d-flex align-items-center">
                    <a href="index.html">Home<span class="lnr lnr-arrow-right"></span></a>
                    <a href="category.html">Cart</a>
                </nav>
            </div>
        </div>
    </div>
</section>
<section class="cart_area">
    <div class="container">
        <div class="cart_inner">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col" class="col-6">Product</th>
                            <th scope="col" class="col-2">Price</th>
                            <th scope="col" class="col-2">Quantity</th>
                            <th scope="col" class="col-2">Total</th>
                        </tr>
                    </thead>
                    <tbody id="basket-items">
                    </tbody>
                    <tfoot id="checkout-section">
                        <tr>
                            <td></td>
                            <td></td>
                            <td><h5 class="m-0">Subtotal</h5></td>
                            <td><h5 class="m-0" id="basket-total"></h5></td>
                        </tr>
                        <tr>
                            <td colspan="4" class="text-right">
                                <div class="checkout_btn_inner d-flex align-items-center justify-content-end">
                                    <a class="gray_btn mr-3" asp-controller="Product" asp-action="ShopCategory">Continue Shopping</a>
                                    <a class="primary-btn" asp-controller="Order" asp-action="Checkout">Proceed to checkout</a>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/basket/ShippingCart.js" asp-append-version="true"></script>

}