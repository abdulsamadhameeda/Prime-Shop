@model PrimeShop.Application.features.Auth.Register.Dtos.RegisterCommand

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Register</h1>
               
            </div>
        </div>
    </div>
</section>

<section class="login_box_area section_gap">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="login_box_img">
                    <img class="img-fluid" src="/img/login.jpg" alt="">
                    <div class="hover">
                        <h4>Already have an account?</h4>
                        <p>Sign in to access your orders, wishlist and more!</p>
                        <a class="primary-btn" asp-controller="Auth" asp-action="Login">Log In</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner  " style="padding-top:50px">
                    <h3>Create an Account</h3>
                    <form asp-action="Register" method="post" class="row login_form" id="registerForm"   novalidate="novalidate">
                        <div asp-validation-summary="ModelOnly" class="col-md-12 text-danger mb-2"></div>
                        <div class="col-md-12 form-group mb-1">
                            <input asp-for="FirstName" class="form-control" placeholder="First Name"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'First Name'" />
                            <span asp-validation-for="FirstName" class="text-danger small d-block text-start"></span>
                        </div>
                        <div class="col-md-12 form-group mb-1">
                            <input asp-for="LastName" class="form-control" placeholder="Last Name"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Last Name'" />
                            <span asp-validation-for="LastName" class="text-danger small d-block text-start"></span>
                        </div>
                        <div class="col-md-12 form-group mb-1">
                            <input asp-for="Email" class="form-control" placeholder="Email"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Email'" />
                            <span asp-validation-for="Email" class="text-danger small d-block text-start"></span>
                        </div>
                        <div class="col-md-12 form-group mb-1">
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Password'" />
                            <span asp-validation-for="Password" class="text-danger small d-block text-start"></span>
                        </div>
                        <div class="col-md-12 form-group mb-1">
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Phone Number'" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small d-block text-start  "></span>
                        </div>
                        <div class="col-md-12 form-group">
                            <button type="submit" value="submit" class="primary-btn">Create Account</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#registerForm').submit(function (e) {
                e.preventDefault(); 

                var form = $(this);

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function (response) {
                        var newForm = $(response).find('#registerForm').html();
                        if (newForm) {
                            $('#registerForm').html(newForm);
                        } else {
                            window.location.href = '/Auth/Login';
                        }
                    }
                });
            });
        });
    </script>
}