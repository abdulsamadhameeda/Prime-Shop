@model PrimeShop.Application.features.Auth.Login.Dtos.LoginCommand
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Login</h1>
             
            </div>
        </div>
    </div>
</section>
<section class="login_box_area section_gap">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="login_box_img">
                    <img class="img-fluid" src="/img/login.jpg" alt="">
                    <div class="hover">
                        <h4>New to our website?</h4>
                        <p>Sign up now and enjoy exclusive deals, track your orders and more!</p>
                        <a class="primary-btn" asp-controller="Auth" asp-action="Register">Create an Account</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner">
                    <h3>Login to enter</h3>
                    <form asp-action="Login" method="post" class="row login_form" novalidate="novalidate">
                        <div class="col-md-12 form-group">
                            <input asp-for="Email" class="form-control" placeholder="Email"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Email'" />
                        </div>
                        <div class="col-md-12 form-group">
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Password'" />
                        </div>

                        <div class="col-md-12 form-group">
                            <button type="submit" value="submit" class="primary-btn">Log In</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>